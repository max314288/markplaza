{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/tiendas/layout,_N_T_/tiendas/[slug]/layout,_N_T_/tiendas/[slug]/page,_N_T_/tiendas/ferreteria"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/tiendas/$d$slug/__PAGE__",
    "/tiendas/$d$slug",
    "/tiendas",
    "/_index",
    "/_head"
  ]
}